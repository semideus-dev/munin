{
  "name": "munin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/core",
    "packages/local",
    "apps/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "pretypecheck": "npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pretest": "npm run build",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.0",
    "typescript": "^5.9.3"
  }
}
