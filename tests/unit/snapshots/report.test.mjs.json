        "unpriced": false,
        "pricingAsOf": "2026-10-22",
        "confidence": "low",
        "confidenceBasis": "low because 2 duplicate(s) is too thin to average",
        "assumptions": [
          "A duplicate read returns the same content the context already had: no edit to that file, and no change at all for a search, came in between.",
          "The duplicate stays in the prefix until the context ends or a compaction clears it.",
          "Removing it changes nothing else about the call."
        ],
        "calculation": "For each duplicate: result tokens x (cache-write rate + remaining calls in context x cache-read rate) / 1,000,000, on the 2026-01-01 rate card, at the duplicate's own model and time.",
